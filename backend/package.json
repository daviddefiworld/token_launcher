{
  "name": "token-automation-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "compile:tokens": "node scripts/compile-tokens.js",
    "build": "tsc && node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','skills','tokenlaunch','compiled');const dst=path.join('dist','skills','tokenlaunch','compiled');if(fs.existsSync(src)){fs.mkdirSync(path.dirname(dst),{recursive:true});fs.cpSync(src,dst,{recursive:true});}\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "googleapis": "^144.0.0",
    "socket.io": "^4.8.1",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.19",
    "solc": "0.8.25",
    "solc0819": "npm:solc@0.8.19",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
